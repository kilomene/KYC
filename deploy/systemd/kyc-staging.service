[Unit]
Description=KYC identity verification platform — STAGING (synthetic data only)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=HOME=/home/hatch
# Staging has its OWN operator token and master key under
# data-staging/ (chmod 600, gitignored). It must never share
# production's data dir, keys, or tunnel.
EnvironmentFile=-/home/hatch/workspace/KYC/data-staging/platform-admin.env
Environment=KYC_MASTER_KEY_FILE=/home/hatch/workspace/KYC/data-staging/kyc-master.key
Environment=KYC_OCR2=on
WorkingDirectory=/home/hatch/workspace/KYC
ExecStart=/usr/bin/python3 -m server --port 8792 --data-dir data-staging
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
