[Unit]
Description=KYC identity verification platform (Nova Inc) — local server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=HOME=/home/hatch
# Optional platform-operator token for POST /v1/tenants (WS0 audit fix).
# Create data/platform-admin.env (chmod 600) containing
# KYC_PLATFORM_ADMIN_TOKEN=<token> to enable tenant creation; when the
# file is absent, tenant creation stays disabled (fail closed).
EnvironmentFile=-/home/hatch/workspace/KYC/data/platform-admin.env
# WS3 storage encryption: master key for stored document/biometric files
# (AES-256-GCM envelope). The key VALUE lives only in that file
# (chmod 600, gitignored data/); without it media reads fail closed (503).
Environment=KYC_MASTER_KEY_FILE=/home/hatch/workspace/KYC/data/kyc-master.key
Environment=KYC_OCR2=on
WorkingDirectory=/home/hatch/workspace/KYC
ExecStart=/usr/bin/python3 -m server --port 8790
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
